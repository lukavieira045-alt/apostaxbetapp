<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roleta - ApostaXBet</title>
    <style>
        body { background-color: #0f1923; color: white; font-family: Arial, sans-serif; text-align: center; padding: 20px; }
        h1 { color: #00ff88; }
        #resultado { font-size: 60px; margin: 40px 0; min-height: 70px; }
        button { padding: 15px 30px; font-size: 18px; background: #00ff88; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; }
        button:active { transform: scale(0.95); }
        a { display: block; margin-top: 30px; color: #aaa; text-decoration: none; }
    </style>
</head>
<body>
    <h1>🎡 Roleta da Sorte</h1>
    <div id="resultado">❓</div>
    <button onclick="girar()">GIRAR AGORA</button>
    <br><br>
    <a href="../index.html"> Voltar para o Menu</a>

    <script>
        function girar() {
            const el = document.getElementById('resultado');
            el.innerText = '...';
            
            setTimeout(() => {
    const opcoes = ['0', '🔴', '⚫'];
    const sorteado = opcoes[Math.floor(Math.random() * opcoes.length)];

    el.innerText = sorteado;

    if (sorteado === '🔴') {
        el.style.color = '#ff4444';
    } else if (sorteado === '⚫') {
        el.style.color = '#ffffff';
    } else {
        el.style.color = '#00ff88';
    }
}, 500);
} 
                
            }, 500);
        }
    </script>
</body>
</html>
